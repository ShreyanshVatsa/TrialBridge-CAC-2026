# Env file for the e2e Worker (playwright.config.ts passes it via `wrangler dev --env-file`).
# Passing --env-file stops wrangler from loading .dev.vars, so real AI keys never reach e2e:
# every AI key is blank, so the deterministic mock provider is used. Turnstile/salt fall back to dev test values.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=
