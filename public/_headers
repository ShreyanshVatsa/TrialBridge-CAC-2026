# Security and caching headers for Cloudflare Workers static assets.
# CSP notes: inline scripts are externalized at build (scripts/postbuild.ts), so script-src needs no
# 'unsafe-inline'. 'wasm-unsafe-eval' is required for Transformers.js / ONNX Runtime WebAssembly.
# challenges.cloudflare.com is required by Turnstile (script + iframe).
# style-src 'unsafe-inline': React inline style attributes (progress bar, charts, map tiles). Accepted
# low risk because script-src is strict (no inline scripts, no eval); revisit with class-based styles.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=(), bluetooth=(), serial=(), hid=(), xr-spatial-tracking=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/data/shards/*
  Cache-Control: public, max-age=31536000, immutable

/data/zip/*
  Cache-Control: public, max-age=2592000

/models/*
  Cache-Control: public, max-age=31536000, immutable

/ort/*
  Cache-Control: public, max-age=31536000, immutable

/data/meta.json
  Cache-Control: public, max-age=300, must-revalidate

/data/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: no-cache
