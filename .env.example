# Public (client) config. Copy to .env.local if needed.
# Turnstile site key; default is Cloudflare's documented always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# API base for local dev when the Next dev server and wrangler dev run on different ports.
NEXT_PUBLIC_API_BASE=
# Partner/contact email for the "For research sites" button (read at build time).
# Leave empty to show "Partnership contact coming soon" instead of a mailto link.
NEXT_PUBLIC_PARTNER_EMAIL=
